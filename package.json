{
  "name": "yasin-chess",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:offline": "npm run build && node scripts/offline-smoke.mjs",
    "benchmark:mobile": "npm run build && node scripts/mobile-benchmark.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:open": "cap open android",
    "android:build": "npm run build && cap sync android",
    "android:debug": "npm run android:build && cd android && ./gradlew assembleDebug",
    "android:init": "node scripts/android-bootstrap.mjs",
    "android:identity": "node scripts/android-identity.mjs",
    "audit:offline-assets": "npm run build && node scripts/offline-asset-audit.mjs",
    "test:storage": "npm test -- tests/storage-health.test.ts",
    "audit:network": "node scripts/network-isolation-audit.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vitest": "latest",
    "jsdom": "latest",
    "@capacitor/core": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  }
}
